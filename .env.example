# Safe by default: no network requests are made in simulated mode.
NDM_MODE=simulated
NDM_ALLOWED_TARGETS=example.com,localhost,127.0.0.1,cloudflare-dns.com,1.1.1.1
NDM_ALLOW_LAB_RANGES=false
NDM_MIN_CHECK_INTERVAL_SECONDS=2.0
NDM_TIMEOUT_SECONDS=3.0
NDM_SLOW_DNS_THRESHOLD_MS=500
NDM_DNS_RESOLVERS=1.1.1.1,8.8.8.8
